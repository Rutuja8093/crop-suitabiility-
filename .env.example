# ==============================================================================
# SoilPilot - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and adjust variables for your local development environment.
# DO NOT commit .env with real secrets to version control.

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=soilpilot_insecure_development_secret_key_please_change_in_production

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend API Configuration
# Note: In Next.js client-side code, variables must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CORS Allowed Origins (comma-separated list for backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with PostGIS extension)
# For local non-Docker development:
DATABASE_URL=postgresql://soilpilot_user:soilpilot_password@localhost:5432/soilpilot_db

# For Docker Compose networking:
# DATABASE_URL=postgresql://soilpilot_user:soilpilot_password@db:5432/soilpilot_db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=soilpilot_user
POSTGRES_PASSWORD=soilpilot_password
POSTGRES_DB=soilpilot_db
POSTGRES_PORT=5432

# ==============================================================================
# Open Government Data (data.gov.in) / AGMARKNET API Integration (Phase 4)
# ==============================================================================
# Register for a free API key at https://data.gov.in to enable live daily mandi sync.
# Leave blank to use honest pending/unconfigured state or manual bulletin upload.
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

