# ==============================================================================
# SoilPilot Frontend - Vercel & Production Environment Variables
# ==============================================================================

# 1. Backend URL (used by Next.js server-side rewrites & PDF proxy routes):
# Set this in Vercel Project Settings -> Environment Variables
BACKEND_URL=https://your-backend-service.onrender.com

# 2. Public API URL (optional - if omitted, defaults to /api/v1 which proxies via BACKEND_URL):
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com/api/v1
